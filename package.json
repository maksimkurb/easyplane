{
  "name": "easyplane",
  "version": "0.0.0",
  "private": true,
  "description": "Control plane for EasyTier: protocol-compatible config server + web panel",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json --pretty && tsc -p tsconfig.test.json && bun run --cwd apps/web typecheck",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:conformance": "vitest run --project conformance",
    "dev": "tsc -b tsconfig.build.json && tsx apps/server/src/main.ts",
    "db:generate": "cd apps/server && bunx drizzle-kit generate",
    "db:migrate": "tsx apps/server/src/db/migrate-cli.ts",
    "openapi:generate": "tsx apps/server/src/openapi.ts",
    "protos:sync": "scripts/sync-protos.sh",
    "protos:check": "scripts/check-protos.sh",
    "test-client:build": "scripts/build-test-client.sh",
    "lint": "bun run --cwd apps/web lint",
    "test:web": "bun run --cwd apps/web test",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "build:all": "bun run build && bun run web:build",
    "test:load": "tsx --tsconfig tsconfig.test.json scripts/load-test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "ts-proto": "^2.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "ws": "^8.18.3"
  }
}
