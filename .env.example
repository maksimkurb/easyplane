# EasyPlane configuration. Copy to .env and change every CHANGE_ME.
# Generate secrets with: openssl rand -base64 32

# --- PostgreSQL (used by docker-compose.yml) --------------------------------
POSTGRES_DB=easyplane
POSTGRES_USER=easyplane
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Server ---------------------------------------------------------------
# 32-byte key for AES-256-GCM at rest encryption of EasyTier network secrets.
# base64 (44 chars), base64url or 64 hex chars. Losing it makes stored network
# secrets unrecoverable.
EASYPLANE_ENCRYPTION_KEY=CHANGE_ME_32_byte_key

# One-time admin bootstrap. Stops working after the first admin exists unless
# EASYPLANE_BOOTSTRAP_REENABLE=true (then remove it again afterwards).
EASYPLANE_BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME_bootstrap_token
EASYPLANE_BOOTSTRAP_REENABLE=false

# Browser-visible origin of the panel. Must match the OIDC redirect URIs
# (https://<host>/api/auth/callback/<provider>).
EASYPLANE_PUBLIC_URL=https://easyplane.example.com
# Base used in the invite command. Point it at the wss endpoint: either the
# built-in TLS listener or a reverse proxy that forwards to 22023.
EASYPLANE_PUBLIC_CONFIG_SERVER_URL=wss://vpn.example.com

EASYPLANE_TRUST_PROXY=true
EASYPLANE_SECURE_COOKIES=true
EASYPLANE_ORG_NAME=EasyPlane
EASYPLANE_ORG_SLUG=default
EASYPLANE_LOG_LEVEL=info

# --- OIDC providers (JSON array) -----------------------------------------
# Any OpenID Connect provider with discovery + authorization code + PKCE.
# Redirect URI to register: https://<panel-host>/api/auth/callback/<id>
EASYPLANE_OIDC_PROVIDERS=[{"id":"keycloak","label":"Company SSO","issuer":"https://sso.example.com/realms/main","clientId":"easyplane","clientSecret":"CHANGE_ME_client_secret","scopes":"openid email profile","roleClaim":"groups","adminGroups":["easyplane-admins"],"memberGroups":["easyplane-members"],"defaultRole":"viewer","allowedEmailDomains":["example.com"]}]

# --- Database -------------------------------------------------------------
# PostgreSQL connection pool size per server process.
# EASYPLANE_DATABASE_POOL_SIZE=10

# --- Tuning (defaults shown) ---------------------------------------------
# EASYPLANE_SESSION_IDLE_MINUTES=720
# EASYPLANE_SESSION_ABSOLUTE_HOURS=168
# EASYPLANE_DEVICE_ONLINE_TIMEOUT_MS=5000
# Heartbeats arrive every second; last-seen/identity is persisted at most this
# often (must stay well below the online timeout).
# EASYPLANE_HEARTBEAT_PERSIST_INTERVAL_MS=2000
# EASYPLANE_RECONCILE_INTERVAL_MS=15000
# How often (per device) route reports are collected from the client.
# EASYPLANE_ROUTE_REPORT_INTERVAL_MS=30000
# EASYPLANE_UNKNOWN_TOKEN_LIMIT_PER_MINUTE=30
# EASYPLANE_MAX_PENDING_DEVICES_PER_NETWORK=100
# Config-server admission caps and liveness: a tunnel that stops
# heartbeating (half-open TCP, dead NAT) is closed after this timeout.
# EASYPLANE_MAX_CLIENT_CONNECTIONS=2000
# EASYPLANE_CLIENT_ACCEPT_LIMIT_PER_MINUTE=600
# EASYPLANE_CLIENT_HEARTBEAT_TIMEOUT_MS=20000
# Blanket HTTP API limit per client IP (auth/import add stricter limits).
# EASYPLANE_API_RATE_LIMIT_PER_MINUTE=600

# --- Metrics (optional) ---------------------------------------------------
# Prometheus text endpoint on the main app, requiring this bearer token.
# Leave empty to disable. Example scrape config:
#   authorization: { credentials: <token> }
# EASYPLANE_METRICS_TOKEN=
# Alternatively (or additionally) serve /metrics and /health on an internal
# listener with no auth. Never publish this port; bind it to localhost/VPC.
# EASYPLANE_METRICS_HOST=127.0.0.1
# EASYPLANE_METRICS_PORT=9464

# --- Realtime (SSE) and topology map (M3) ---------------------------------
# Concurrent browser event streams per user (a tab uses one, plus one while
# the topology map is open) and per server process.
# EASYPLANE_SSE_MAX_PER_USER=4
# EASYPLANE_SSE_MAX_TOTAL=500
# Events kept for Last-Event-ID replay after a reconnect.
# EASYPLANE_SSE_EVENT_BUFFER=500

# Topology is collected with CollectNetworkInfo per online device: slowly when
# nobody watches the map, fast while at least one browser has it open (jitter
# is a fraction, 0.2 = ±20%).
# EASYPLANE_TOPOLOGY_IDLE_INTERVAL_MS=30000
# EASYPLANE_TOPOLOGY_ACTIVE_INTERVAL_MS=5000
# EASYPLANE_TOPOLOGY_JITTER=0.2
# Parallel probes and the per-device RPC timeout.
# EASYPLANE_TOPOLOGY_CONCURRENCY=4
# EASYPLANE_TOPOLOGY_TIMEOUT_MS=5000
# Devices probed per network cycle; larger fleets are truncated (map is marked
# partial), raise it if you have more than 500 devices online.
# EASYPLANE_TOPOLOGY_MAX_DEVICES=500

# --- Config-server listeners ---------------------------------------------
# The container reaches these ports directly; ws and tcp are published by
# docker-compose.yml. Add wss here only if the server terminates TLS itself.
# UDP is implemented (SYN/SACK session layer) but disabled unless set; publish
# it in docker-compose only if clients use udp:// URLs.
# EASYPLANE_UDP_PORT=22021
# EASYPLANE_HTTP_PORT=8080
EASYPLANE_TCP_PORT=22020
EASYPLANE_WS_PORT=22023
# EASYPLANE_WSS_PORT=22024
# EASYPLANE_TLS_CERT=/certs/fullchain.pem
# EASYPLANE_TLS_KEY=/certs/privkey.pem

# --- Optional host bindings for docker-compose ---------------------------
# EASYPLANE_HTTP_BIND=0.0.0.0:8080
# EASYPLANE_TCP_BIND=0.0.0.0:22020
# EASYPLANE_WS_BIND=0.0.0.0:22023

# --- Bundled rendezvous node (optional) ----------------------------------
# A stock easytier-core public node that helps devices find each other (initial
# contact, peer RPC, NAT hole punching). It does NOT forward user data unless
# RENDEZVOUS_RELAY_DATA=true, which CGNAT/symmetric-NAT users need.
#
# Start it with:  docker compose --profile rendezvous up -d
# It publishes TCP 11010, UDP 11010 and TCP 11011 (ws); forward those on the
# host/VPS. No TUN device or capabilities are required.
#
# RENDEZVOUS_NETWORK_SECRET is REQUIRED (the process refuses an empty value)
# and is the who-may-use-it key: private mode only admits foreign networks that
# prove this secret. Use openssl rand -base64 32.
# RENDEZVOUS_NETWORK_NAME=easyplane-rendezvous
# RENDEZVOUS_NETWORK_SECRET=
# RENDEZVOUS_RELAY_DATA=false
# RENDEZVOUS_PRIVATE_MODE=true
# Keep secure mode on: private mode's shared-secret proof only exists in the
# Noise handshake, which EasyTier performs only in secure mode. Turning it off
# makes a private node reject every foreign network (even with the right secret)
# and is only meaningful together with RENDEZVOUS_PRIVATE_MODE=false.
# RENDEZVOUS_SECURE_MODE=true
# RENDEZVOUS_NETWORK_WHITELIST=*
# Non-whitelisted networks are rejected entirely. With
# RENDEZVOUS_RELAY_ALL_PEER_RPC=true they may still rendezvous, but only
# whitelisted networks get data relay (a second layer for relay-only limits).
# RENDEZVOUS_RELAY_ALL_PEER_RPC=false
# RENDEZVOUS_LISTENERS=tcp://0.0.0.0:11010,udp://0.0.0.0:11010,ws://0.0.0.0:11011
# RENDEZVOUS_HOSTNAME=rendezvous
# Optional hard cap on data relayed for foreign networks, bytes/second.
# RENDEZVOUS_FOREIGN_RELAY_BPS_LIMIT=10485760
# Public addresses to advertise when the node is behind 1:1 NAT/port mapping.
# RENDEZVOUS_MAPPED_LISTENERS=tcp://rv.example.com:11010
# RENDEZVOUS_IMAGE=easytier/easytier:v2.7.0
# RENDEZVOUS_TCP_BIND=0.0.0.0:11010
# RENDEZVOUS_UDP_BIND=0.0.0.0:11010
# RENDEZVOUS_WS_BIND=0.0.0.0:11011
#
# Panel side: endpoints every device in an opted-in network will dial, plus the
# same node identity/secret for exact checks and the "align network secret"
# action. Leave EASYPLANE_RENDEZVOUS_ENDPOINTS empty to hide the feature.
# EASYPLANE_RENDEZVOUS_ENDPOINTS=tcp://rv.example.com:11010,udp://rv.example.com:11010,ws://rv.example.com:11011
# EASYPLANE_RENDEZVOUS_RELAY_DATA=false
# EASYPLANE_RENDEZVOUS_PRIVATE_MODE=true
# EASYPLANE_RENDEZVOUS_NETWORK_NAME=easyplane-rendezvous
# EASYPLANE_RENDEZVOUS_SECRET=

# ---------------------------------------------------------------------------
# Credential-mode networks (docs/CREDENTIALS.md)
# ---------------------------------------------------------------------------
# A network can use per-device credentials instead of one shared secret
# ("Device authentication" on the network page). Anchors hold the network
# secret; members join with a revocable X25519 credential and never see the
# secret. The panel issues and renews those credentials.
#
# Lifetime of a new credential. A renewal repushes the anchors, which restarts
# their EasyTier instance for a moment, so keep this long.
# EASYPLANE_CREDENTIAL_TTL_DAYS=90
# Renew when less than this many days remain (clamped below the TTL). Renewal
# is batched per network and idempotent.
# EASYPLANE_CREDENTIAL_RENEW_BEFORE_DAYS=14
#
# Rotating a credentials network's secret keeps every member credential valid
# (members never verify the HMAC proofs; anchors re-sign them). If the network
# uses the bundled rendezvous node, update RENDEZVOUS_NETWORK_SECRET on the
# node in the same operation: private mode admits only the node's own secret.
