# EasyPlane configuration. Copy to .env and change every CHANGE_ME.
# Generate secrets with: openssl rand -base64 32

# --- PostgreSQL (used by docker-compose.yml) --------------------------------
POSTGRES_DB=easyplane
POSTGRES_USER=easyplane
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# --- Server ---------------------------------------------------------------
# 32-byte key for AES-256-GCM at rest encryption of EasyTier network secrets.
# base64 (44 chars), base64url or 64 hex chars. Losing it makes stored network
# secrets unrecoverable.
EASYPLANE_ENCRYPTION_KEY=CHANGE_ME_32_byte_key

# One-time admin bootstrap. Stops working after the first admin exists unless
# EASYPLANE_BOOTSTRAP_REENABLE=true (then remove it again afterwards).
EASYPLANE_BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME_bootstrap_token
EASYPLANE_BOOTSTRAP_REENABLE=false

# Browser-visible origin of the panel. Must match the OIDC redirect URIs
# (https://<host>/api/auth/callback/<provider>).
EASYPLANE_PUBLIC_URL=https://easyplane.example.com
# Base used in the invite command. Point it at the wss endpoint: either the
# built-in TLS listener or a reverse proxy that forwards to 22023.
EASYPLANE_PUBLIC_CONFIG_SERVER_URL=wss://vpn.example.com

EASYPLANE_TRUST_PROXY=true
EASYPLANE_SECURE_COOKIES=true
EASYPLANE_ORG_NAME=EasyPlane
EASYPLANE_ORG_SLUG=default
EASYPLANE_LOG_LEVEL=info

# --- OIDC providers (JSON array) -----------------------------------------
# Any OpenID Connect provider with discovery + authorization code + PKCE.
# Redirect URI to register: https://<panel-host>/api/auth/callback/<id>
EASYPLANE_OIDC_PROVIDERS=[{"id":"keycloak","label":"Company SSO","issuer":"https://sso.example.com/realms/main","clientId":"easyplane","clientSecret":"CHANGE_ME_client_secret","scopes":"openid email profile","roleClaim":"groups","adminGroups":["easyplane-admins"],"memberGroups":["easyplane-members"],"defaultRole":"viewer","allowedEmailDomains":["example.com"]}]

# --- Tuning (defaults shown) ---------------------------------------------
# EASYPLANE_SESSION_IDLE_MINUTES=720
# EASYPLANE_SESSION_ABSOLUTE_HOURS=168
# EASYPLANE_DEVICE_ONLINE_TIMEOUT_MS=5000
# EASYPLANE_RECONCILE_INTERVAL_MS=15000
# EASYPLANE_UNKNOWN_TOKEN_LIMIT_PER_MINUTE=30
# EASYPLANE_MAX_PENDING_DEVICES_PER_NETWORK=100

# --- Config-server listeners ---------------------------------------------
# The container reaches these ports directly; ws and tcp are published by
# docker-compose.yml. Add wss here only if the server terminates TLS itself.
# EASYPLANE_HTTP_PORT=8080
EASYPLANE_TCP_PORT=22020
EASYPLANE_WS_PORT=22023
# EASYPLANE_WSS_PORT=22024
# EASYPLANE_TLS_CERT=/certs/fullchain.pem
# EASYPLANE_TLS_KEY=/certs/privkey.pem

# --- Optional host bindings for docker-compose ---------------------------
# EASYPLANE_HTTP_BIND=0.0.0.0:8080
# EASYPLANE_TCP_BIND=0.0.0.0:22020
# EASYPLANE_WS_BIND=0.0.0.0:22023
